{
    "name": "chatflowphp/core",
    "description": "Platform-neutral conversational runtime for PHP: scenes as states on top of chatflowphp/automata.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "chatbot",
        "conversation",
        "state-machine",
        "scenes",
        "telegram"
    ],
    "homepage": "https://github.com/chatflowphp/core",
    "authors": [
        {
            "name": "Alex",
            "email": "webnarmin@gmail.com",
            "role": "maintainer",
            "homepage": "https://github.com/webnarmin"
        }
    ],
    "support": {
        "issues": "https://github.com/chatflowphp/core/issues",
        "source": "https://github.com/chatflowphp/core"
    },
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "chatflowphp/automata": "^2.0",
        "php-di/php-di": "^7.0",
        "psr/clock": "^1.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/translation-contracts": "^3.0"
    },
    "suggest": {
        "phpunit/phpunit": "Required by ChatFlow\\Testing\\ApplicationTester.",
        "ext-pdo": "Required for PDO-backed session storage.",
        "ext-redis": "Required for Redis-based session storage.",
        "symfony/translation-contracts": "Required by SymfonyTranslatorAdapter to reuse an existing symfony/translation catalogue."
    },
    "autoload": {
        "psr-4": {
            "ChatFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChatFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
