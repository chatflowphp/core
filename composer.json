{
    "name": "chatflowphp/core",
    "description": "Platform-neutral conversational flow core for PHP.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/chatflowphp/core",
    "authors": [
        {
            "name": "Alex",
            "email": "webnarmin@gmail.com",
            "role": "maintainer",
            "homepage": "https://github.com/webnarmin"
        }
    ],
    "support": {
        "issues": "https://github.com/chatflowphp/core/issues",
        "source": "https://github.com/chatflowphp/core"
    },
    "require": {
        "php": "^8.2",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "vlucas/phpdotenv": "^5.5",
        "chatflowphp/automata": "^1.0"
    },
    "suggest": {
        "ext-redis": "Required for Redis-based session storage.",
        "ext-pdo": "Required for PDO-backed session storage.",
        "symfony/translation": "Required if you use the optional translator adapters."
    },
    "autoload": {
        "psr-4": {
            "ChatFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChatFlow\\Tests\\": "tests/",
            "ChatFlow\\Tests\\Fixtures\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symfony/translation": "^7.0 || ^8.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml",
        "analyse": "vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ],
        "cs-fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
        "cs-check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
