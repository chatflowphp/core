# --- Application ---
# Enables verbose user-facing error messages in the default exception registry.
APP_DEBUG=false

# Default locale for optional translator providers.
APP_LOCALE=en

# --- Logging ---
# Supported drivers in MonologProvider: file, stack.
LOG_DRIVER=file
LOG_PATH=storage/logs/chatflow-core.log
# Monolog levels: 100=DEBUG, 200=INFO, 300=WARNING, 400=ERROR, 500=CRITICAL
LOG_LEVEL=100
# Supported formats: text, json
LOG_FORMAT=text

# --- Database (PDO storage provider) ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatflow
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Redis storage provider ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
